"\u003c!DOCTYPE html>\n\u003chtml lang=\"en\">\n\u003chead>\n\u003cmeta charset=\"UTF-8\">\n\u003ctitle>Example short\u003c/title>\n\u003cstyle>\nhtml,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#0b1020;font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Arial,sans-serif}\ncanvas{position:absolute;left:0;top:0;width:1080px;height:1920px;display:block}\n#title{position:absolute;left:0;top:170px;width:1080px;text-align:center;color:#fff;font-size:88px;font-weight:800;letter-spacing:-1px;text-shadow:0 4px 24px rgba(0,0,0,.55)}\n#sub{position:absolute;left:0;top:290px;width:1080px;text-align:center;color:#9fc4ff;font-size:36px;font-weight:600;letter-spacing:4px;text-transform:uppercase}\n#label{position:absolute;left:60px;top:1500px;padding:18px 34px;border-radius:44px;background:#fff;color:#0b1020;font-size:46px;font-weight:700;box-shadow:0 10px 30px rgba(0,0,0,.4)}\n\u003c/style>\n\u003cscript type=\"importmap\">{\"imports\":{\"three\":\"https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.module.min.js\"}}\u003c/script>\n\u003c/head>\n\u003cbody>\n\u003ccanvas id=\"c\" width=\"1080\" height=\"1920\">\u003c/canvas>\n\u003cdiv id=\"title\">Hello, Short!\u003c/div>\n\u003cdiv id=\"sub\">Example animation\u003c/div>\n\u003cdiv id=\"label\">Moving label\u003c/div>\n\u003cscript type=\"module\">\nimport * as THREE from \"three\";\nwindow.DURATION = 6;\nconst renderer = new THREE.WebGLRenderer({canvas: document.getElementById(\"c\"), antialias: true});\nrenderer.setPixelRatio(1);\nrenderer.setSize(1080, 1920, false);\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x0b1020);\nconst camera = new THREE.PerspectiveCamera(40, 1080 / 1920, 0.1, 100);\ncamera.position.set(0, 0, 9);\nscene.add(new THREE.AmbientLight(0xffffff, 0.5));\nconst sun = new THREE.DirectionalLight(0xffffff, 2.2);\nsun.position.set(4, 6, 8);\nscene.add(sun);\nconst knot = new THREE.Mesh(new THREE.TorusKnotGeometry(1.6, 0.5, 160, 24), new THREE.MeshStandardMaterial({color: 0x3b82f6, roughness: 0.35, metalness: 0.2}));\nscene.add(knot);\nconst label = document.getElementById(\"label\");\nwindow.renderAt = function (t) {\n  knot.rotation.set(t * 0.9, t * 1.3, 0);\n  knot.position.y = Math.sin(t * 2) * 0.4;\n  renderer.render(scene, camera);\n  const p = Math.min(1, t / window.DURATION);\n  label.style.transform = \"translateX(\" + Math.round(p * 520) + \"px)\";\n  label.textContent = \"Moving label \" + Math.round(p * 100) + \"%\";\n};\nwindow.renderAt(0);\n\u003c/script>\n\u003c/body>\n\u003c/html>\n"
